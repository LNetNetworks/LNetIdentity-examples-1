# Default base path of the dwallet API. The OpenAPI document declares `/wallet`
# as the server base, so it is part of the URL. Optional — this is also the
# built-in default in src/api/client.ts.
VITE_IDENTITY_API_BASE_URL=https://dev-identity-dwallet.l-net.io/wallet

# Default base path for the ssi-vc API. Users can override both dwallet and
# ssi-vc URLs from Settings after login.
VITE_SSI_VC_API_BASE_URL=https://dev-identity-api.l-net.io/
